POSTGRES_DB=tinytune
POSTGRES_USER=tinytune
POSTGRES_PASSWORD=tinytune-local-only
DB_POOL_SIZE=8
DB_ACQUIRE_TIMEOUT_SECONDS=1.0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=30
PLAY_MODE=async
WORKER_PROCESSING_DELAY_MS=25
WORKER_BATCH_SIZE=25
WORKER_CLAIM_IDLE_MS=5000
LOG_LEVEL=INFO
SUCCESS_LOG_SAMPLE_RATE=0.01

# Google Identity Services: Web application client ID (no client secret needed).
# Authorized JavaScript origins: http://localhost and http://localhost:8080
GOOGLE_CLIENT_ID=
APP_ORIGIN=http://localhost:8080
TOOLS_ORIGIN=http://localhost:8081
SESSION_COOKIE_SECURE=false

